# DocMind Environment Configuration
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=1

# Redis (for local development with Docker)
REDIS_URL=redis://localhost:6379
DOC_TTL_SECONDS=86400
COMPRESS_THRESHOLD=32768
USE_S3_FOR_LARGE=1
S3_BUCKET=my-doc-bucket
S3_THRESHOLD=2242880

# PostgreSQL
DATABASE_URL=postgresql://Postgres:root@127.0.0.1:5432/postgres
# OR use individual components:
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_USER=Postgres
# PG_PASSWORD=root
# PG_DB=postgres

# Password reset mailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=1
OTP_EXPIRY_MINUTES=10

# Optional Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FLASK_PUBLIC_URL=http://localhost:5000
NEXTJS_BASE_URL=http://localhost:3000

# Groq LLM synthesis layer
GROQ_API_KEY=gsk_your_key_here
LLM_ENABLED=1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=8
LLM_MAX_EVIDENCE_BLOCKS=4
LLM_MAX_CHARS_PER_BLOCK=1800
LLM_MAX_TOTAL_EVIDENCE_CHARS=5000
LLM_CLARIFY_SCORE_THRESHOLD=0.62
LLM_CLARIFY_MARGIN=0.04
RUN_GROQ_INTEGRATION_TESTS=0
